@{
    ViewData["Title"] = "Home";
}

<!-- section principale -->
<div class="hero-section" style="padding: 1px 0;">

    <h1 class="hero-title">
        Stocks Investhink
    </h1>

    <p class="hero-subtitle mt-2">
        Simple stock analysis for beginners. Import data, visualize trends, and explore buy or sell signals (Educational, not Recommendations).
    </p>

    <!-- boutons -->
    <div class="mt-3">

        <a class="btn btn-primary-custom me-2"
               asp-controller="Account"
               asp-action="Register">
            Get Started
        </a>

        <a class="btn btn-outline-custom"
               asp-controller="Account"
               asp-action="Login">
            Login
        </a>

    </div>

</div>


<!-- section features -->
<div class="row mt-4" style="padding: 1px 0;">

    <div class="col-md-4 mb-3">
        <div class="app-card text-center p-3">
            <h5>Import CSV</h5>
            <p class="mt-1">
                Upload historical stock data easily and start analyzing in seconds.
            </p>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="app-card text-center p-3">
            <h5>Technical Indicators</h5>
            <p class="mt-1">
                Use SMA, EMA and RSI to understand market trends.
            </p>
        </div>
    </div>

    <!-- feature 3 -->
    <div class="col-md-4 mb-3">
        <div class="app-card text-center p-3">
            <h5>Buy / Sell Signals</h5>
            <p class="mt-1">
                Get simple recommendations based on recent signals.
            </p>
        </div>
    </div>

</div>


<!-- section call to action -->
<div class="text-center mt-1" style="padding: 1px 0;">

    <div class="app-card p-3">

        <h5>Start analyzing stocks today</h5>

        <p class="mt-1">
            Create an account and explore your first dataset.
        </p>

        <a class="btn btn-primary-custom mt-2"
               asp-controller="Account"
               asp-action="Register">
            Create Account
        </a>

    </div>

</div>