@{
    // recuperation de la liste des stocks envoyee par le controller
    var stocks = ViewBag.Stocks;
}

<!-- page import csv -->
<div class="auth-container">

    <div class="auth-card" style="max-width: 650px;">

        <!-- titre -->
        <div class="text-center mb-4">
            <h2 class="mb-2">Import CSV</h2>
            <p class="text-secondary">
                Upload a CSV file and choose a stock to analyze
            </p>
        </div>

        @if (TempData["Message"] != null)
        {
            <!-- message succes -->
            <div class="alert alert-success" role="alert">
                @TempData["Message"]
            </div>
        }

        <!-- formulaire import -->
        <form method="post" enctype="multipart/form-data">

            <!-- selection stock -->
            <div class="mb-3">
                <label for="stockId" class="form-label">Stock</label>
                <select id="stockId" name="stockId" class="form-select">
                    @foreach (var s in stocks)
                    {
                        <option value="@s.StockId">@s.Ticker</option>
                    }
                </select>
            </div>

            <!-- selection fichier -->
            <div class="mb-3">
                <label for="file" class="form-label">CSV File</label>
                <input id="file"
                       type="file"
                       name="file"
                       class="form-control"
                       required />
            </div>

            <!-- boutons -->
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary-custom">
                    Import
                </button>

                <button type="button"
                        class="btn btn-outline-custom"
                        onclick="goToResults()">
                    View Results
                </button>
            </div>

        </form>

    </div>

</div>

<script>
    // fonction pour ouvrir la page des resultats
    function goToResults() {
        const stockId = document.getElementById("stockId").value;
        window.location.href = "/Analysis/Results?stockId=" + stockId;
    }
</script>