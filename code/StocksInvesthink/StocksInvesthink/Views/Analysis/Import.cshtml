@{
    // recuperation de la liste des stocks envoyee par le controller
    var stocks = ViewBag.Stocks;
}

<h2>Import CSV</h2>

@if (TempData["Message"] != null)
{
    <!-- message de confirmation apres import -->
    <p style="color:green">@TempData["Message"]</p>
}

<!-- formulaire pour importer un fichier CSV -->
<form method="post" enctype="multipart/form-data">

    <!-- selection du stock -->
    <div>
        <label>Stock</label>
        <select id="stockId" name="stockId">
            @foreach (var s in stocks)
            {
                <option value="@s.StockId">@s.Ticker</option>
            }
        </select>
    </div>

    <br />

    <!-- selection du fichier CSV -->
    <div>
        <input type="file" name="file" required />
    </div>

    <br />

    <!-- bouton pour lancer import -->
    <button type="submit">Importer</button>

    <!-- bouton pour voir les resultats -->
    <button type="button" onclick="goToResults()">Voir resultats</button>

</form>

<script>
    // fonction pour ouvrir la page des resultats
    function goToResults() {
        const stockId = document.getElementById("stockId").value;
        window.location.href = "/Analysis/Results?stockId=" + stockId;
    }
</script>