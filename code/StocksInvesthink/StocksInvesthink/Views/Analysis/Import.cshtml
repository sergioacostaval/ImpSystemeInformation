@{
    // Récupération de la liste des stocks envoyée par le controller
    var stocks = ViewBag.Stocks;
}

<h2>Import CSV</h2>

@if (TempData["Message"] != null)
{
    <!-- Message de confirmation après l'import -->
    <p style="color:green">@TempData["Message"]</p>
}

<!-- Formulaire pour importer un fichier CSV -->
<form method="post" enctype="multipart/form-data">

    <!-- Sélection du stock -->
    <div>
        <label>Stock</label>
        <select name="stockId">
            @foreach (var s in stocks)
            {
                <option value="@s.StockId">@s.Ticker</option>
            }
        </select>
    </div>

    <br />

    <!-- Sélection du fichier CSV -->
    <div>
        <input type="file" name="file" required />
    </div>

    <br />

    <!-- Bouton pour lancer l'import -->
    <button type="submit">Importer</button>

</form>