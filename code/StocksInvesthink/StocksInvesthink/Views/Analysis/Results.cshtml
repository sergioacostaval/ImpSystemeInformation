<!-- librairie pour dessign graphique -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- pour serializer avec Json -->
@using System.Text.Json

@model List<StocksInvesthink.ViewModels.AnalysisResultViewModel>

@{
    // donnees principales du stock
    var firstItem = Model.FirstOrDefault();
    var stockTicker = firstItem?.StockTicker ?? "";
    var stockName = firstItem?.StockName ?? "";
    var startDate = Model.Any() ? Model.First().Date.ToShortDateString() : "";
    var endDate = Model.Any() ? Model.Last().Date.ToShortDateString() : "";
    var totalRows = Model.Count;
    var combinedSignal = Model.LastOrDefault()?.CombinedSignal ?? "Hold";

    // Signal selon la recommandation finale
    var signalClass =
        combinedSignal == "Strong Buy" || combinedSignal == "Buy" ? "signal-buy" :
        combinedSignal == "Strong Sell" || combinedSignal == "Sell" ? "signal-sell" :
        "signal-hold";
}

<!-- resume principal -->
<div class="container mb-4">

    <div class="app-card">

        <!-- titre principal -->
        <div class="text-center mb-4">
            <h2 class="mb-1">@stockTicker</h2>
            <p class="text-secondary mb-0">@stockName</p>
        </div>

        <!-- cartes resume -->
        <div class="row text-center">

            <div class="col-md-3 mb-3">
                <div class="app-card h-100 p-3">
                    <h6 class="text-secondary">Period</h6>
                    <strong>@startDate - @endDate</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="app-card h-100 p-3">
                    <h6 class="text-secondary">Values</h6>
                    <strong>@totalRows</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="app-card h-100 p-3">
                    <h6 class="text-secondary">Indicators</h6>
                    <strong>SMA / EMA / RSI</strong>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="app-card h-100 p-3">
                    <h6 class="text-secondary">Recommendation</h6>
                    <strong class="@signalClass">@combinedSignal</strong>
                    <div class="small text-secondary mt-2">
                        Based on recent signals
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@if (!Model.Any())
{
    <!-- message si aucune donnee -->
    <div class="alert alert-warning">
        No analysis data available for this stock.
    </div>
}
else
{
    <!-- espace pour graphique sma -->
    <div class="app-card mb-4">
        <h4 class="mb-3">Price and SMA (@stockTicker)</h4>
        <canvas id="smaChart" height="90"></canvas>
    </div>

    <!-- espace pour graphique ema -->
    <div class="app-card mb-4">
        <h4 class="mb-3">Price and EMA (@stockTicker)</h4>
        <canvas id="emaChart" height="90"></canvas>
    </div>

    <!-- espace pour graphique rsi -->
    <div class="app-card mb-4">
        <h4 class="mb-3">Price and RSI (@stockTicker)</h4>
        <canvas id="rsiChart" height="90"></canvas>
    </div>

    <script>
        // transformation des donnees C# en listes pour graphiquer avec Chart.js
        
        // labels contient les dates pour l axe horizontal
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.Date.ToShortDateString())));
        
        // valeurs numeriques affichees dans les graphiques
        const closePrices = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.ClosePrice)));
        const smaValues = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.Sma)));
        const emaValues = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.Ema)));
        const rsiValues = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.Rsi)));

        // signaux generes par chaque indicateur
        const smaSignals = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.SmaSignal)));
        const emaSignals = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.EmaSignal)));
        const rsiSignals = @Html.Raw(JsonSerializer.Serialize(Model.Select(r => r.RsiSignal)));

        // lignes horizontales pour le RSI
        const rsi30Line = labels.map(() => 30);
        const rsi70Line = labels.map(() => 70);

        // couleurs du theme
        const chartTextColor = "#f8fafc";
        const chartGridColor = "rgba(148, 163, 184, 0.15)";
        const chartBuyColor = "#22c55e";
        const chartSellColor = "#ef4444";

        // cette fonction prepare les fleches verts et rouges des signaux
        function buildSignalDatasets(signalArray, buyValue, sellValue, sourceData, yAxisId = 'y') {
            const buyData = signalArray.map((signal, index) => signal === buyValue ? sourceData[index] : null);
            const sellData = signalArray.map((signal, index) => signal === sellValue ? sourceData[index] : null);

            return {
                buyDataset: {
                    label: buyValue,
                    type: 'line',
                    data: buyData,
                    yAxisID: yAxisId,
                    showLine: false,
                    pointRadius: 7,
                    pointHoverRadius: 9,
                    pointStyle: 'triangle',
                    pointRotation: 0,
                    pointBackgroundColor: chartBuyColor,
                    pointBorderColor: chartBuyColor
                },
                sellDataset: {
                    label: sellValue,
                    type: 'line',
                    data: sellData,
                    yAxisID: yAxisId,
                    showLine: false,
                    pointRadius: 7,
                    pointHoverRadius: 9,
                    pointStyle: 'triangle',
                    pointRotation: 180,
                    pointBackgroundColor: chartSellColor,
                    pointBorderColor: chartSellColor
                }
            };
        }

        // options reutilisees par les graphiques
        function getCommonOptions(titleText) {
            return {
                responsive: true,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        labels: {
                            color: chartTextColor
                        }
                    },
                    title: {
                        display: true,
                        text: titleText,
                        color: chartTextColor
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: chartTextColor
                        },
                        grid: {
                            color: chartGridColor
                        }
                    },
                    y: {
                        beginAtZero: false,
                        ticks: {
                            color: chartTextColor
                        },
                        grid: {
                            color: chartGridColor
                        }
                    }
                }
            };
        }

        // creation du graphique SMA
        const smaSignalDatasets = buildSignalDatasets(smaSignals, 'Buy', 'Sell', closePrices);

        const smaCtx = document.getElementById('smaChart');

        new Chart(smaCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Close Price',
                        data: closePrices,
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    {
                        label: 'SMA',
                        data: smaValues,
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    smaSignalDatasets.buyDataset,
                    smaSignalDatasets.sellDataset
                ]
            },
            options: getCommonOptions('Price vs SMA with Buy and Sell Signals')
        });

        // creation du graphique EMA
        // il utilise la meme structure que le graphique SMA
        const emaSignalDatasets = buildSignalDatasets(emaSignals, 'Buy EMA', 'Sell EMA', closePrices);

        const emaCtx = document.getElementById('emaChart');

        new Chart(emaCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Close Price',
                        data: closePrices,
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    {
                        label: 'EMA',
                        data: emaValues,
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    emaSignalDatasets.buyDataset,
                    emaSignalDatasets.sellDataset
                ]
            },
            options: getCommonOptions('Price vs EMA with Buy and Sell Signals')
        });

        // creation du graphique RSI
        const rsiSignalDatasets = buildSignalDatasets(rsiSignals, 'Buy RSI', 'Sell RSI', closePrices, 'yPrice');

        // graphique prix et RSI avec double axe
        const rsiCtx = document.getElementById('rsiChart');

        new Chart(rsiCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Close Price',
                        data: closePrices,
                        yAxisID: 'yPrice',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    {
                        label: 'RSI',
                        data: rsiValues,
                        yAxisID: 'yRsi',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.25
                    },
                    {
                        label: 'RSI 30',
                        data: rsi30Line,
                        yAxisID: 'yRsi',
                        borderWidth: 1,
                        pointRadius: 0,
                        borderDash: [5, 5]
                    },
                    {
                        label: 'RSI 70',
                        data: rsi70Line,
                        yAxisID: 'yRsi',
                        borderWidth: 1,
                        pointRadius: 0,
                        borderDash: [5, 5]
                    },
                    rsiSignalDatasets.buyDataset,
                    rsiSignalDatasets.sellDataset
                ]
            },
            options: {
                responsive: true,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        labels: {
                            color: chartTextColor
                        }
                    },
                    title: {
                        display: true,
                        text: 'Price and RSI with Thresholds',
                        color: chartTextColor
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: chartTextColor
                        },
                        grid: {
                            color: chartGridColor
                        }
                    },
                    yPrice: {
                        type: 'linear',
                        position: 'left',
                        beginAtZero: false,
                        ticks: {
                            color: chartTextColor
                        },
                        grid: {
                            color: chartGridColor
                        },
                        title: {
                            display: true,
                            text: 'Price',
                            color: chartTextColor
                        }
                    },
                    yRsi: {
                        type: 'linear',
                        position: 'right',
                        min: 0,
                        max: 100,
                        ticks: {
                            color: chartTextColor
                        },
                        grid: {
                            drawOnChartArea: false
                        },
                        title: {
                            display: true,
                            text: 'RSI',
                            color: chartTextColor
                        }
                    }
                }
            }
        });
    </script>
}