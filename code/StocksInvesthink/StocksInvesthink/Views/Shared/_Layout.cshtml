<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StocksInvesthink</title>

    <!-- bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!--Icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- css global -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- navbar principale -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">

                <!-- logo ou nom -->
                <a class="navbar-brand fw-bold d-flex align-items-center"
                       asp-controller="Home"
                       asp-action="Index">

                    <!-- icone graphique -->
                    <i class="bi bi-graph-up-arrow me-2"></i>

                    Stocks Investhink
                </a>

                <!-- bouton mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- contenu navbar -->
                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- menu gauche -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Analysis"
                               asp-action="Import">Import CSV</a>
                        </li>

                    </ul>

                    <!-- menu droite -->
                    <ul class="navbar-nav">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- utilisateur connecte -->
                            <li class="nav-item">
                                <span class="nav-link">
                                    Bonjour @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <!-- login -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">Login</a>
                            </li>

                            <!-- register -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">Register</a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- contenu principal -->
    <div class="container mt-2">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- footer -->
    <footer class="text-center footer-custom mt-5 mb-3">
        <small>
            © 2026 StocksInvesthink - Educational stock analysis platform
        </small>
    </footer>

    <!-- scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>